# Banco de dados transacional (fonte oficial dos registros)
DATABASE_URL="postgresql://financeira:financeira@localhost:5432/financeira?schema=public"

# Segredo para assinatura de sessão (troque em produção; >= 32 chars)
SESSION_SECRET="dev-secret-change-me-0123456789abcdef"

# Modo demonstração: roda o app inteiro com adaptadores em memória e dados
# fictícios, sem precisar de PostgreSQL. Nunca usar em produção.
DEMO_MODE=1

# Fuso horário padrão (configurável por empresa)
DEFAULT_TIMEZONE="America/Sao_Paulo"

# IA para classificação/explicação (opcional). Provider "mock" usa heurística
# determinística local, claramente identificada como mock.
AI_PROVIDER="mock"
# ANTHROPIC_API_KEY=""

# Barramento de eventos: in-process com outbox (padrão) ou fila real BullMQ.
# Para a fila real (apenas modo produção): EVENT_BUS=bullmq + REDIS_URL, e rode
# o worker em processo separado: npx tsx scripts/event-worker.ts
# EVENT_BUS="bullmq"
# REDIS_URL="redis://localhost:6379"
