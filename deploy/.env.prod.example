# Modelo do ambiente de produção. Copie para deploy/.env.prod (NÃO versionado)
# e preencha. Usado por docker-compose.prod.yml.

# --- Banco (usado pelo container Postgres E montado na DATABASE_URL do app) ---
POSTGRES_USER=financeira
POSTGRES_PASSWORD=TROQUE-POR-UMA-SENHA-FORTE
POSTGRES_DB=financeira

# --- Role RESTRITA do app e do scheduler -------------------------------------
# POSTGRES_USER acima é SUPERUSUÁRIO (a imagem oficial do Postgres o cria
# assim) e fica só para as migrations. O app e o scheduler usam esta role, que
# não tem superpoderes e não pode alterar nem apagar a trilha de auditoria.
# Crie-a uma vez com: deploy/criar-role-app.sh
# Senha (só letras e números — a senha entra numa URL, e / + = quebram):
#   openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 32; echo
APP_DB_USER=financeira_app
APP_DB_PASSWORD=TROQUE-POR-UMA-SENHA-FORTE

# --- App ---
# Gere: openssl rand -base64 48   (o app se recusa a iniciar sem isto em produção)
SESSION_SECRET=TROQUE-POR-UM-SEGREDO-ALEATORIO-FORTE

# Porta local onde o app escuta (o nginx faz proxy para 127.0.0.1:APP_PORT).
APP_PORT=3000

DEFAULT_TIMEZONE=America/Sao_Paulo

# IA opcional (mock por padrão). Para ligar a IA real: AI_PROVIDER=anthropic + chave.
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=
